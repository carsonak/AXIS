# Local HTTP port for the stateless AXIS server.
PORT=8080

# Use "fixture" for deterministic demos/tests or "live" for KijaniSpace with climatology fallback.
AXIS_WEATHER_MODE=fixture

# KijaniSpace credentials stay on the server. Leave the key blank when using fixture mode.
KIJANISPACE_API_URL=https://api.kijanispace.eu/v1/agro_climate/land
KIJANISPACE_API_KEY=

# Optional grounded explanations are disabled by default and never change deterministic advice.
# The endpoint must implement the OpenAI-compatible chat-completions API; credentials remain server-side.
# Gemini example endpoint: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Use a Gemini model available to your API key, for example the model configured in your Google AI project.
AXIS_AI_INSIGHTS_ENABLED=false
AXIS_AI_ENDPOINT=
AXIS_AI_API_KEY=
AXIS_AI_MODEL=

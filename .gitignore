# Local reference wireframes; intentionally not part of the repository.
/AXIS.webp

# Secrets and local environment overrides.
.env
.env.*
!.env.example

# Frontend dependencies and generated compiler output.
/frontend/node_modules/
/frontend/dist/
/frontend/*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts

# Vite writes the production PWA below this directory. Only the marker is
# versioned so Go can embed the parent directory in a fresh source checkout.
/backend/web/dist/*
!/backend/web/dist/source-only.txt

# Local build and editor output.
/axis
*.log
.DS_Store
